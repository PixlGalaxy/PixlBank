# Copy to .env (same folder) and adjust. Everything except the ADMIN_* block
# can also be changed later from Admin Panel -> Settings without touching this file.

# ---------------------------------------------------------------------------
# Lender (admin) account — required
# ---------------------------------------------------------------------------
# There is exactly one admin: you, the lender. It's created on first boot with
# these values. After that you can change the password from the web (Settings ->
# My Account) and it stays — unless you edit ADMIN_PASSWORD here, which applies
# the new value on next start (handy if you forget it).
# Changing ADMIN_USERNAME / ADMIN_EMAIL here renames the account on next start.
ADMIN_USERNAME=pixl
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
# Optional name shown in the app and emails.
# ADMIN_DISPLAY_NAME=PixlBank

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# UI language for the login screen and new accounts: en | es
LANGUAGE=es
# Timezone that decides "today" for due dates, overdue checks and reminders.
TZ=America/Lima
# Public URL of this install, used for links inside emails (optional).
# APP_URL=https://bank.example.com
# Host port the container is published on (docker-compose.yml).
PORT_HTTP=8080

# ---------------------------------------------------------------------------
# Email (SMTP) — first-boot defaults for Admin Panel -> Settings -> Email
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465 (direct TLS)
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=PixlBank <you@gmail.com>

# ---------------------------------------------------------------------------
# Receipt verification (Ollama) — first-boot defaults for Admin Panel -> Settings
# ---------------------------------------------------------------------------
# Your Ollama server, reachable from inside the container. A multimodal model
# must be pulled there first, e.g. `ollama pull gemma3:12b`.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=gemma3:12b

# ---------------------------------------------------------------------------
# Sessions and security (editable later; need a backend restart to apply)
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=24
# true only when serving over HTTPS, otherwise the session cookie never comes back.
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Receipt uploads per IP (each runs the vision model).
RECEIPT_RATE_LIMIT_MAX=10
RECEIPT_RATE_LIMIT_WINDOW_MINUTES=60
# Other websites allowed to call the API from a browser (CORS), comma-separated
# exact origins: scheme + host (+ port), no path. Leave empty — the default —
# when you only use PixlBank's own web UI: then no other site can call the API.
# Example: CORS_ORIGINS=https://bank.example.com,http://localhost:5173
# Note: the session cookie is SameSite=Lax, so cookies only travel between
# origins of the same site (e.g. app.example.com <-> api.example.com).
CORS_ORIGINS=
# Proxies allowed to report the visitor's real IP (Nginx Proxy Manager, Traefik,
# Cloudflare...). Comma-separated: uniquelocal, linklocal, cloudflare, or IPs/CIDRs.
# TRUST_PROXY=uniquelocal

# Optional: country map on the admin dashboard (free key at maxmind.com).
# MAXMIND_LICENSE_KEY=
# DISABLE_UPDATE_CHECK=false
